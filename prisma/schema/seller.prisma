enum SellerRequestStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum CuisineType {
  MEDITERRANEAN
  ITALIAN
  CHINESE
  INDIAN
  MEXICAN
  OTHER
}

model SellerProfile {
  id                String              @id @default(auto()) @map("_id") @db.ObjectId
  userId            String              @unique @db.ObjectId
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName      String
  ownerName         String
  phone             String
  cuisineTypes      CuisineType[]
  description       String
  address           String
  latitude          Float?
  longitude         Float?
  location          Json?
  averageRating     Float               @default(0)
  reviewCount       Int                 @default(0)
  workingHours      Json?
  pickupAvailable           Boolean             @default(false)
  deliveryAvailable         Boolean             @default(false)
  kitchenImages             String[]
  governmentId              String?
  status                    SellerRequestStatus @default(PENDING)
  adminNote                 String?
  stripeAccountId           String?
  stripeChargesEnabled      Boolean             @default(false)
  stripePayoutsEnabled      Boolean             @default(false)
  stripeOnboardingCompleted Boolean             @default(false)
  favoritedBy               FavoriteSeller[]
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  @@map("seller_profiles")
}

model FavoriteSeller {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  userId          String        @db.ObjectId
  user            User          @relation("UserFavoriteSellers", fields: [userId], references: [id], onDelete: Cascade)
  sellerProfileId String        @db.ObjectId
  sellerProfile   SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@unique([userId, sellerProfileId])
  @@map("favorite_sellers")
}
