enum UserRole {
  ADMIN
  BUYER
  SELLER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum VerificationType {
  REGISTER_VERIFY
  PASSWORD_RESET
}

model User {
  id                 String          @id @default(auto()) @map("_id") @db.ObjectId
  name               String
  password           String?
  email              String          @unique
  role               UserRole        @default(BUYER)
  status             UserStatus      @default(ACTIVE)
  phone              String?
  profilePicture     String?
  username           String?         @unique
  bio                String?
  birthday           String?
  gender             String?
  address            String?
  isSeller           Boolean         @default(false)
  dietaryPreferences String[]
  allergies          String[]
  language           String?
  country            String?
  timeZone           String?
  dateFormat         String?
  timeFormat         String?
  units              String?
  currency           String?
  fcmToken           String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  sellerProfile      SellerProfile?

  // Collaborative Grocery Relations
  createdGroceries   GroceryList[]       @relation("GroceryCreator")
  groceryMemberships GroceryMember[]     @relation("GroceryUserMember")
  addedItems         GroceryItem[]       @relation("ItemAddedBy")
  completedItems     GroceryItem[]       @relation("ItemCompletedBy")
  sentInvitations    GroceryInvitation[] @relation("InvitationInvitedBy")
  notifications      Notification[]

  @@map("users")
}

model VerificationCode {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  email     String
  code      String
  type      VerificationType
  expiresAt DateTime
  createdAt DateTime         @default(now())

  @@unique([email, type])
  @@map("verification_codes")
}
