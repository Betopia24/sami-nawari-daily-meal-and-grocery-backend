generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id                 String     @id @default(auto()) @map("_id") @db.ObjectId
  name               String
  password           String?
  email              String     @unique
  role               UserRole   @default(USER)
  status             UserStatus @default(ACTIVE)
  phone              String?
  profilePicture     String?
  username           String?    @unique
  bio                String?
  birthday           String?
  gender             String?
  address            String?
  isSeller           Boolean    @default(false)
  dietaryPreferences String[]
  allergies          String[]
  language           String?
  country            String?
  timeZone           String?
  dateFormat         String?
  timeFormat         String?
  units              String?
  currency           String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@map("users")
}

enum VerificationType {
  REGISTER_VERIFY
  PASSWORD_RESET
}

model VerificationCode {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  email     String
  code      String
  type      VerificationType
  expiresAt DateTime
  createdAt DateTime         @default(now())

  @@unique([email, type])
  @@map("verification_codes")
}
